{
  "name": "luca-ai-heartbeat",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev:full": "node server/index.js",
    "start": "vite build && node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/**/*.test.js\"",
    "deploy:guard": "node deploy/assert-production-deploy.mjs",
    "deploy:check": "node deploy/assert-production-deploy.mjs",
    "stage:release": "node deploy/stage-release.mjs",
    "deploy:stage": "node deploy/stage-release.mjs",
    "promo": "npm run build && node promo/scripts/capture-product.mjs && remotion render promo/src/index.tsx Promo promo/dist/luca-ai-commercial.mp4 --codec=h264 --crf=16 --overwrite --public-dir=promo/public"
  },
  "dependencies": {
    "express": "^5.2.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.460.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.1",
    "three": "^0.185.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.344",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.55.1",
    "postcss": "^8.5.0",
    "remotion": "^4.0.344",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
