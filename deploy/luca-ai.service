[Unit]
Description=LUCA operational persona workbench
After=network-online.target kamui-backend.service yume-backend.service
Wants=network-online.target

[Service]
Type=simple
User=luca-ai
Group=luca-ai
WorkingDirectory=/opt/sennin/luca-ai/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4242
Environment=LUCA_DATA_DIR=/var/lib/luca-ai
EnvironmentFile=/etc/sennin/luca-ai.env
ExecStartPre=/usr/bin/test -f /opt/sennin/luca-ai/current/dist/index.html
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/luca-ai
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
